# PayPal Sandbox (from developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=xxxx
PAYPAL_CLIENT_SECRET=xxxx
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Protects the dashboard and admin actions (approve, reject, freeze, policy edits).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=xxxx

# Database (SQLite file by default)
DATABASE_URL=sqlite:///./agent_wallet.db

# Frontend URL allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:5173